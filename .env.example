# Copy this file to ".env" and change the values. Never commit .env.

# Database login (only used inside this machine). Change the password on a server.
POSTGRES_USER=lead
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lead

# Shown to website owners in every crawler request so they can contact you.
# Use a separate inbox (e.g. a new Gmail). Required from Phase 3.
CRAWLER_CONTACT_EMAIL=crawler-contact@example.invalid

# How many jobs one worker process runs at once.
WORKER_CONCURRENCY=4

# Memory and CPU threads DuckDB may use for bulk data (Common Crawl scans, reports).
# Lower these on small machines (e.g. 1GB / 2).
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4
# Most disk space DuckDB may use for very large queries (spill files in data/duckdb-tmp).
DUCKDB_MAX_TEMP=4GB

# DNS lookups: leave empty to use the dashboard setting (default "udp", fastest).
# Set to "doh" (DNS over HTTPS) only if your network blocks normal DNS.
DNS_MODE=

# Chrome/Chromium used for Lighthouse audits. The Docker worker image already includes Chromium,
# so set this only when you run the worker outside Docker (e.g. CHROME_PATH=/usr/bin/chromium).
# CHROME_PATH=

# Port for the dashboard.
WEB_PORT=3000

# Log detail: error | warn | info | debug
LOG_LEVEL=info
